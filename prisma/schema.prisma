generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (pgbouncer, puerto 6543) - usada en runtime
  directUrl = env("DIRECT_URL") // conexión directa (puerto 5432) - usada solo por `prisma migrate`
}

enum TipoCategoria {
  INGRESO
  COSTO
  GASTO
}

enum Prioridad {
  ALTA
  MEDIA
  BAJA
}

enum Frecuencia {
  DIARIA
  SEMANAL
  MENSUAL
  ANUAL
  PUNTUAL
}

enum FuenteConsejo {
  REGLA
  IA
}

enum EstadoConsejo {
  PENDIENTE
  APLICADO
  DESCARTADO
}

enum UnidadMedida {
  UNIDAD
  KILO
  LITRO
}

enum EstadoPresupuesto {
  ABIERTO
  CERRADO
}

model Category {
  id        String        @id @default(cuid())
  name      String        @unique
  type      TipoCategoria
  priority  Prioridad     @default(MEDIA)
  frequency Frecuencia    @default(MENSUAL)
  color     String?
  archived  Boolean       @default(false)
  createdAt DateTime      @default(now())

  movements   Movement[]
  budgetItems BudgetItem[]
  adviceItems AdviceItem[]

  @@map("categories")
}

model Movement {
  id         String     @id @default(cuid())
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  date       DateTime
  amount     Decimal    @db.Decimal(12, 2)
  frequency  Frecuencia @default(PUNTUAL)
  note       String?
  receiptUrl String?
  createdAt  DateTime   @default(now())

  @@index([categoryId, date])
  @@map("movements")
}

// Un año de presupuesto puede tener varias versiones: la v1 nace ABIERTA y se
// edita en el lugar; al "cerrarla" queda fija. Si despues se vuelve a editar,
// se crea automaticamente una v2 (copia de la anterior) para no perder el
// historial de lo que se planifico originalmente.
model BudgetPlan {
  id        String            @id @default(cuid())
  year      Int
  version   Int
  status    EstadoPresupuesto @default(ABIERTO)
  label     String?
  closedAt  DateTime?
  createdAt DateTime          @default(now())

  items BudgetItem[]

  @@unique([year, version])
  @@map("budget_plans")
}

model BudgetItem {
  id            String     @id @default(cuid())
  planId        String
  plan          BudgetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  year          Int
  month         Int
  plannedAmount Decimal    @db.Decimal(12, 2)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([planId, categoryId, month])
  @@map("budget_items")
}

model AdviceItem {
  id               String        @id @default(cuid())
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title            String
  description      String
  source           FuenteConsejo
  estimatedSavings Decimal?      @db.Decimal(12, 2)
  sourceUrl        String?
  status           EstadoConsejo @default(PENDIENTE)
  createdAt        DateTime      @default(now())

  @@map("advice_items")
}

// Plan de bencina de un mes: precio por litro, rendimiento y km que se
// recorren cada dia de la semana (indice 0 = lunes ... 6 = domingo).
model FuelPlan {
  id            String   @id @default(cuid())
  year          Int
  month         Int
  pricePerLiter Decimal  @db.Decimal(8, 2)
  kmPerLiter    Decimal  @db.Decimal(6, 2)
  kmPorDia      Int[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([year, month])
  @@map("fuel_plans")
}

// Producto de consumo recurrente (pan, leche...) para proyectar su gasto mensual.
// priceBasis = unidad en la que esta expresado el precio; quantityBasis = unidad
// en la que se anota la cantidad diaria. Si difieren (UNIDAD <-> KILO) se usa
// unitWeightGrams (peso de una unidad) para convertir.
model ConsumptionItem {
  id              String        @id @default(cuid())
  name            String        @unique
  priceBasis      UnidadMedida
  quantityBasis   UnidadMedida
  unitWeightGrams Int?
  createdAt       DateTime      @default(now())

  plans ConsumptionPlan[]

  @@map("consumption_items")
}

model ConsumptionPlan {
  id        String          @id @default(cuid())
  itemId    String
  item      ConsumptionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  price     Decimal         @db.Decimal(12, 2)
  qtyPorDia Float[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([itemId, year, month])
  @@map("consumption_plans")
}
